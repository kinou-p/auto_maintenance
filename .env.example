# ============================================
# Auto Maintenance - Configuration
# ============================================

# --- Application ---
APP_NAME=auto_maintenance
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0

# --- Frontend ---
FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=5173

# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./data/auto_maintenance.db

# --- DDEV ---
# Par défaut: <projet>/data/ddev-projects (portable Windows/Linux)
# Pour Docker-in-Docker: chemin ABSOLU identique hôte ET container
# DDEV_PROJECTS_DIR=
# HOST_DDEV_PROJECTS=
DDEV_PHP_VERSION=8.2
DDEV_WEBSERVER_TYPE=nginx-fpm
DDEV_MARIADB_VERSION=10.6

# --- Workflows ---
MAX_CONCURRENT_WORKFLOWS=2

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=2048

# --- WordPress ---
WP_ADMIN_USER=admin_temp
WP_ADMIN_PASSWORD=temp_password_change_me
WP_ADMIN_EMAIL=admin@localhost.local
WP_LOCALE=fr_FR

# --- Assets ---
AIO_PLUGIN_ZIP_PATH=./assets/all-in-one-wp-migration.zip

# --- Screenshots & Multi-Breakpoints ---
SCREENSHOT_ENABLED_DEVICES=desktop,mobile
SCREENSHOT_DESKTOP_WIDTH=1920
SCREENSHOT_DESKTOP_HEIGHT=1080
SCREENSHOT_TABLET_WIDTH=768
SCREENSHOT_TABLET_HEIGHT=1024
SCREENSHOT_MOBILE_WIDTH=375
SCREENSHOT_MOBILE_HEIGHT=812
PLAYWRIGHT_TIMEOUT=60000
SCREENSHOT_SCROLL_DELAY_MS=60
SCREENSHOT_SCROLL_STEP_PX=400
SCREENSHOT_IMAGES_WAIT_TIMEOUT_MS=4000


# --- VRT (Visual Regression Testing) ---
VRT_THRESHOLD=0.1
VRT_ANTI_ALIASING_TOLERANCE=2
VRT_DIFF_COLOR_R=255
VRT_DIFF_COLOR_G=0
VRT_DIFF_COLOR_B=255

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Sudo ---
# Method: sudoers | pkexec | prompt
SUDO_METHOD=sudoers
